APP_ENV=development
DATABASE_URL=postgresql+asyncpg://poidem:poidem@db:5432/poidem
# TEST_DATABASE_URL должен указывать только на отдельную тестовую БД
# TEST_DATABASE_URL=postgresql+asyncpg://poidem:poidem@localhost:5432/poidem_test
PARSER_SCHEDULER_ENABLED=false
PARSER_REQUEST_TIMEOUT_SECONDS=20
PARSER_MAX_RETRIES=3
PARSER_REQUEST_DELAY_SECONDS=1
STALE_AFTER_DAYS=7
